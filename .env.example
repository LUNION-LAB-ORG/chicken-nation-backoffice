# Public URL of the deployed backoffice (used for SEO, OG tags, etc.)
NEXT_PUBLIC_URL=""

# Backend API
# Production : https://api-private.chicken-nation.com
# (chicken.turbodeliveryapp.com et api-staging.chicken-nation.com sont hors service)
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_API_PREFIX="/api/v1"

# AWS CloudFront — CDN for media (S3 bucket)
NEXT_PUBLIC_CLOUDFRONT_URL=""

# Google Maps API key (delivery zones, restaurant location)
# Clé Google Maps du NAVIGATEUR.
#
# ⚠️ Inlinée dans le bundle au moment du BUILD, pas au démarrage. Changer cette
# valeur sur le serveur ne suffit pas : il faut RECONSTRUIRE l'image, sinon
# l'ancienne clé reste dans le JavaScript déjà compilé.
#
# ⚠️ Sans guillemets. Selon la façon dont l'environnement est injecté, des
# guillemets peuvent être conservés dans la valeur et rendre la clé invalide.
#
# ⚠️ Le projet Google qui porte cette clé doit être rattaché à un compte de
# FACTURATION, sinon Places répond BillingNotEnabledMapError et la carte
# affiche « Impossible de charger Google Maps correctement sur cette page ».
# Une clé destinée au navigateur est lisible par tous : elle doit être
# restreinte au référent du backoffice dans la console Google.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# OneSignal — web push notifications
NEXT_PUBLIC_ONESIGNAL_APP_ID=""

# === Docker compose only ===
# Bind interface (127.0.0.1 = local only via nginx reverse-proxy ; 0.0.0.0 = public)
HOST_BIND=127.0.0.1
HOST_PORT=3000
